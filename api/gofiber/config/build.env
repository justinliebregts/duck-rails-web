# Public settings baked into the production image. Never put passwords here.
# Set REPLACE_* values once for each game before building.
API_VERSION=v1
APP_VERSION=0.2.7
DB_PROTOCOL=tcp
DB_HOST=10.199.1.2:3306
DB_NAME=duckrails_tencent_global
DB_ACCOUNT=duckrailsuser
REDIS_HOST=10.199.1.33
REDIS_PORT=6379
REDIS_USERNAME=
OCULUS_APPID=28912202281742343
ENABLE_PHOTON_AUTH=1
ENABLE_OCULUS_ATTESTATION=1
ENABLE_REQUEST_ID=true
ENABLE_BUILDHASH_CHECK=0
K8S_NAMESPACE=duckrails

# Unique per game AND environment sharing Redis. Duck Rails must not share Classic session keys.
REDIS_NAMESPACE=duckrails
