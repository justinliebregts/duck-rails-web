DEPLOY_ENV=development
API_VERSION=v1
APP_VERSION=1
ENABLE_PHOTON_AUTH=1
PHOTON_AUTH_PHASE=
ENABLE_REQUEST_ID=true
ENABLE_BUILDHASH_CHECK=0
DB_ACCOUNT=
DB_PASSWORD=
DB_PROTOCOL=tcp
DB_HOST=
DB_NAME=gunraiders_classic
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
K8S_NAMESPACE=gunraiders-classic
K8S_CONFIG_SERVICE_NAME=
K8S_SERVICE_URL=
ENABLE_OCULUS_ATTESTATION=0
OCULUS_APPID=
OCULUS_APPSECRET=
OCULUS_BYPASS_NONCE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LIST_ID=
CLOUDFLARE_ZONE_ID=
NONCE_SKIP_PHRASE=
REMOTE_AUTHORIZATION_SKIP=

# Unique per game AND environment sharing Redis. Keep grc for existing Classic data.
REDIS_NAMESPACE=grc
