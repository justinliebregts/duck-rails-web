# Copy to runtime.env; ignored by Git and NOT included in the API image.
# Import into the API workload's game-api-env Secret, then restart its pods.
DB_PASSWORD=
REDIS_PASSWORD=
OCULUS_APPSECRET=
PHOTON_AUTH_PHASE=

# Optional: required for the existing static-token admin website.
# Match the raw token sent by admin/src/stores/auth.js; separate from all values above.
ADMIN_API_TOKEN=

# Optional: comma-separated ORGANIZATION-scoped Meta user IDs for Editor sign-in.
# Empty disables Editor login. These are not app-scoped IDs and do not grant admin access.
META_EDITOR_USER_IDS=
